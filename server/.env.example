# ============================================================================
# SNIPER server environment — copy to server/.env and fill in. Never commit
# server/.env. All secrets below stay server-side (the browser never sees them).
# ============================================================================

# --- Primary database (the CRM core). This repo runs Postgres. Local dev can
# use a local Postgres or SQLite fallback.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/sniper
DATABASE_SSL=false

# Environment mode: demo | sandbox | production
APP_ENV=demo

# Stateless session-token signing secret
NEXUS_AUTH_SECRET=change-me-to-a-strong-random-key

# --- Digitap (Integration Hub & Verification Suite) --------------------------
DIGITAP_ENV=uat                    # uat | prod
DIGITAP_UAT_CLIENT_ID=
DIGITAP_UAT_CLIENT_SECRET=
DIGITAP_PROD_CLIENT_ID=
DIGITAP_PROD_CLIENT_SECRET=

# --- Provider orchestrators --------------------------------------------------
OTP_PROVIDER=cellx                   # cellx | fast2sms | msg91 | twilio | internal
CELLX_API_URL=https://web.smsgw.in/smsapi/httpapi.jsp
CELLX_USERNAME=SNIELE
CELLX_PASSWORD=SNIELE
CELLX_FROM=SNPREL
CELLX_PE_ID=1001609656640066899
CELLX_TEMPLATE_ID=1007719376278893769
CELLX_MESSAGE_TEMPLATE=Hi,As per your requirement, we are checking your loan eligibility & Credit Rating.Pls share this OTP {OTP} as your consent for the same. Tx.SNPREL.
OTP_API_URL=
OTP_API_KEY=

KYC_PROVIDER=digitap
KYC_API_URL=
KYC_API_KEY=

CREDIT_PROVIDER=cibil
CREDIT_API_URL=
CREDIT_API_KEY=

ESIGN_PROVIDER=aadhaar_esign
ESIGN_API_URL=
ESIGN_API_KEY=

DISBURSEMENT_PROVIDER=imps_payout
DISBURSEMENT_API_URL=
DISBURSEMENT_API_KEY=

# --- Webhook security --------------------------------------------------------
WEBHOOK_SECRET=your-webhook-signature-secret

# --- Supabase provider store (hybrid persistence for integration/compliance) -
SUPABASE_URL=https://YOURREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=         # server-only; never ship to the client
